# Copy to .env and change for anything but local development.
# Every value has a development default in docker-compose.yaml.

POSTGRES_PASSWORD=postgres-dev-password
AUTH_DB_PASSWORD=auth-dev-password
USER_DB_PASSWORD=user-dev-password
REDIS_PASSWORD=redis-dev-password

MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=minio-dev-password

# JWT signing secrets (use long random values, e.g. `openssl rand -hex 32`)
ACCESS_SECRET=dev-access-secret-change-me
REFRESH_SECRET=dev-refresh-secret-change-me

# Bootstrap administrator, created by auth_service on start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-dev-password

LOG_LEVEL=info
